# Required for live LLM synthesis. Without it the engine runs in offline
# "Samagra Playbook" mode (curated diagnostics) and never breaks.
OPENAI_API_KEY=

# Optional: override the model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: any OpenAI-compatible endpoint (default: https://api.openai.com/v1)
# OPENAI_BASE_URL=
